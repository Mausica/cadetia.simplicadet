<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Theme for Light Mode -->
    <style name="Base.Theme.Simplify" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary_light</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/focus</item>
        <item name="android:navigationBarColor">@color/nothing</item>

        <!-- Secondary Colors -->
        <item name="backgroundColor">@color/background_l_normal</item>

        <!-- <item name="backgroundTint">@color/black</item> -->
        <item name="colorPrimaryDark">@color/black</item>
        <!-- Text Colors -->
        <item name="textAppearanceBody1">@color/black</item>
        <item name="textAppearanceBody2">@color/black</item>


        <item name="bottomBarGradient">@drawable/gradient_bottom_light</item>

        <item name="backgroundLight">@color/background_l_light</item>
        <item name="backgroundDark">@color/background_l_dark</item>
        <item name="backgroundNormal">@color/background_l_normal</item>

        <item name="shimmerLight">#DDDDDD</item>
        <item name="shimmerDark">#BBBBBB</item>

        <item name="transparentLight">#0D000000</item>

        <item name="textLight">@color/text_l_light</item>
        <item name="textDark">@color/text_l_dark</item>
        <item name="textNormal">@color/black</item>
    </style>

    <!-- Custom Theme -->
    <style name="Theme.Simplicadet" parent="Base.Theme.Simplify"/>

    <!-- Time Picker -->
    <style name="TimePickerDark" parent="@style/ThemeOverlay.MaterialComponents.Dialog">
        <item name="cornerSize">16dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="fontFamily">@font/circular_medium</item>
        <item name="android:fontFamily">@font/circular_medium</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorSecondaryFixed">@color/primary</item>
        <item name="android:numbersBackgroundColor">@color/text_l_dark</item>
        <item name="android:windowBackground">@color/background_l_light</item>
        <item name="android:headerBackground">@color/text_l_dark</item>
    </style>

    <!-- Date Picker -->
    <style name="DatePickerDark" parent="Theme.AppCompat.Light.Dialog">
        <item name="cornerSize">16dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="fontFamily">@font/circular_medium</item>
        <item name="android:fontFamily">@font/circular_medium</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:windowBackground">@color/background_l_light</item>
        <item name="android:selectableItemBackgroundBorderless">@color/background_l_light</item>
        <item name="android:textColorPrimary">@color/text_l_dark</item>
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <item name="android:textColorSecondaryInverse">@color/light</item>
    </style>

    <!-- Bottom Navigation Text -->
    <style name="CustomInactiveBottomNavigationTextAppearance">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:fontFamily">@font/circular_regular</item>
    </style>

    <style name="CustomActiveBottomNavigationTextAppearance">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:fontFamily">@font/circular_regular</item>
    </style>

    <!-- Shape Styles -->
    <style name="SquareShapeOverlay">
        <item name="cornerSize">@dimen/_16sdp</item>
    </style>

    <style name="circleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Navigation Drawer -->
    <style name="NavigationDrawerStyle">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="fontFamily">@font/circular_bold</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/_40sdp</item>
        <item name="android:listPreferredItemPaddingLeft">@dimen/_10sdp</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/_10sdp</item>
    </style>

</resources>
