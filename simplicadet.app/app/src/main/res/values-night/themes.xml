<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Theme for Dark Mode -->
    <style name="Base.Theme.Simplify" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:windowSplashScreenBackground" tools:targetApi="31" >@color/background</item>
        <item name="android:windowLightStatusBar">false</item>


        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <item name="contrastColor">@color/background</item>
        <!-- Secondary Colors -->
        <item name="backgroundColor">@color/background</item>
        <!-- <item name="backgroundTint">@color/white</item> -->
        <item name="colorPrimaryDark">@color/white</item>

        <!-- Text Colors -->
        <item name="textAppearanceBody1">@color/white</item>
        <item name="textAppearanceBody2">@color/white</item>


        <item name="bottomBarGradient">@drawable/gradient_bottom_dark</item>

        <item name="backgroundLight">@color/background_d_light</item>
        <item name="backgroundDark">@color/background_d_dark</item>
        <item name="backgroundNormal">@color/background_d_normal</item>

        <item name="shimmerLight">#444444</item>
        <item name="shimmerDark">#666666</item>

        <item name="transparentLight">#0A0A0A</item>

        <item name="textLight">@color/text_l_light</item>
        <item name="textDark">@color/text_l_dark</item>
        <item name="textNormal">@color/white</item>
    </style>

    <!-- Custom Theme -->
    <style name="Theme.Simplicadet" parent="Base.Theme.Simplify"/>

    <style name="TimePickerDark" parent="@style/ThemeOverlay.MaterialComponents.TimePicker">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/background_l_light</item>
        <item name="colorOnSurface">@color/text_l_dark</item>

        <!-- Legacy attributes (for backwards compatibility) -->
        <item name="colorAccent">@color/primary</item>
        <item name="colorSecondaryFixed">@color/primary</item>
        <item name="android:headerBackground">@color/primary</item>
        <item name="android:numbersBackgroundColor">@android:color/white</item>
        <item name="android:windowBackground">@color/background_l_light</item>
        <item name="android:textColorPrimary">@color/text_l_dark</item>
        <item name="android:textColorSecondary">@android:color/white</item>

        <!-- Material TimePicker specific attributes -->
        <item name="materialTimePickerStyle">@style/Widget.MaterialComponents.TimePicker</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.MaterialComponents.TimePicker</item>
        <item name="materialTimePickerClockStyle">@style/Widget.MaterialComponents.TimePicker.Clock</item>
        <item name="materialTimePickerHeaderBackground">@color/primary</item>
        <item name="materialTimePickerClockFaceBackgroundColor">@android:color/white</item>
        <item name="clockFaceBackgroundColor">@android:color/white</item>

        <!-- Button styles -->
        <item name="android:buttonBarPositiveButtonStyle">@style/TimePickerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TimePickerButtonStyle</item>
    </style>

    <style name="TimePickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="TransparentDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
    </style>

    <!-- Date Picker -->
    <style name="DatePickerDark" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/primary</item>
        <item name="colorSecondaryFixed">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:windowBackground">@color/background_l_light</item>
        <item name="android:selectableItemBackgroundBorderless">@color/background_l_light</item>
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <item name="android:textColorSecondaryInverse">@color/light</item>
    </style>

    <!-- Bottom Navigation Text -->
    <style name="CustomInactiveBottomNavigationTextAppearance">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:fontFamily">@font/circular_regular</item>
    </style>

    <style name="CustomActiveBottomNavigationTextAppearance">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:fontFamily">@font/circular_regular</item>
    </style>

    <!-- Shape Styles -->
    <style name="SquareShapeOverlay">
        <item name="cornerSize">@dimen/_16sdp</item>
    </style>

    <style name="circleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Navigation Drawer -->
    <style name="NavigationDrawerStyle">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="fontFamily">@font/circular_bold</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/_40sdp</item>
        <item name="android:listPreferredItemPaddingLeft">@dimen/_10sdp</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/_10sdp</item>
    </style>

</resources>
