<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <!-- Node Container -->
    <RelativeLayout
        android:id="@+id/nodeContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/node_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <!-- Node Icon -->
        <ImageView
            android:id="@+id/nodeIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_play"
            android:layout_marginBottom="8dp" />

    </RelativeLayout>

    <!-- Title Text -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="HTML Grundlagen"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/textNormal"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Connection Line to Next Node -->
    <View
        android:id="@+id/connectionLine"
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@color/path_locked" />

</LinearLayout>