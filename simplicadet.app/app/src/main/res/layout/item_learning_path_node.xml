<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- Connection Path Container - Behind everything (drawn first) -->
    <FrameLayout
        android:id="@+id/connectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp">

        <!-- Curved connector path will be drawn here - NO elevation so it stays behind -->
        <ImageView
            android:id="@+id/connectionPath"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:elevation="0dp" />

    </FrameLayout>

    <!-- Node Container - Positioned at the top with higher elevation to appear above paths -->
    <FrameLayout
        android:id="@+id/nodeContainer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/node_background_unlocked"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:elevation="8dp">

        <!-- Node Icon -->
        <ImageView
            android:id="@+id/nodeIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:elevation="2dp" />

    </FrameLayout>

</FrameLayout>