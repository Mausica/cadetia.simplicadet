<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutQuizz"
    android:orientation="vertical"
    android:layout_width="@dimen/_120sdp"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:alpha="1"
    android:layout_marginEnd="@dimen/_12sdp"
    android:background="@drawable/home_background_quizz_light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/imageQuizz"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:cropToPadding="false"
            android:src="@drawable/background_nothing_rounded"
            android:visibility="visible"
            app:riv_corner_radius="15dp" />

    </RelativeLayout>

    <TextView
        android:id="@+id/quizzTitle"
        android:text="Great Smarter with Productivity Quizz."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_7sdp"
        android:maxLines="2"
        android:layout_marginBottom="@dimen/_3sdp"
        android:fontFamily="@font/circular_medium"
        android:includeFontPadding="false"
        android:textColor="?attr/textAppearanceBody1"
        android:textSize="@dimen/_10ssp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_7sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_gravity="bottom">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/created_profile"
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_gravity="center"
            app:shapeAppearanceOverlay="@style/circleImageView" />

        <TextView
            android:id="@+id/created_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:fontFamily="@font/circular_bold"
            android:includeFontPadding="false"
            android:textColor="@color/light"
            android:textSize="@dimen/_9ssp"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/verified_profile"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:src="@raw/verified"
            android:layout_gravity="center"
            app:shapeAppearanceOverlay="@style/circleImageView" />
    </LinearLayout>

</LinearLayout>
