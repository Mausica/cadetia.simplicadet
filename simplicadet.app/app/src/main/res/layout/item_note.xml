<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutNote"
    android:orientation="vertical"
    android:layout_marginStart="@dimen/_6sdp"
    android:layout_marginTop="@dimen/_12sdp"
    android:layout_marginEnd="@dimen/_6sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:maxHeight="@dimen/_10sdp"
    android:paddingBottom="@dimen/_12sdp"
    android:background="@drawable/background_light_r15">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/imageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="?attr/shimmerLight"
        android:maxHeight="@dimen/_160sdp"
        android:scaleType="centerCrop"
        android:cropToPadding="false"
        app:riv_corner_radius="15dp"/>
    <TextView
        android:id="@+id/textTitle"
        android:text="@string/lorem_ipsum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:fontFamily="@font/circular_bold"
        android:includeFontPadding="false"
        android:textColor="?attr/textNormal"
        android:textSize="@dimen/_14ssp"/>
    <TextView
        android:id="@+id/textSubtitle"
        android:text="@string/lorem_ipsum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:lineSpacingExtra="1dp"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:fontFamily="@font/circular_medium"
        android:includeFontPadding="false"
        android:textColor="?attr/textNormal"
        android:textSize="@dimen/_12ssp"/>
    <TextView
        android:id="@+id/textDateTime"
        android:text="@string/lorem_ipsum"
        android:maxLines="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:fontFamily="@font/circular_medium"
        android:includeFontPadding="false"
        android:textColor="?attr/textLight"
        android:textSize="@dimen/_8ssp"/>
</LinearLayout>