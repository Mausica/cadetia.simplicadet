<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layoutInstitutionContainer">

    <LinearLayout
        android:id="@+id/institution_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_delete_note"
        android:layout_marginLeft="@dimen/_44sdp"
        android:layout_marginRight="@dimen/_44sdp"
        android:orientation="vertical"
        android:paddingTop="@dimen/_16sdp"
        android:elevation="7dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:text="Select Account Type"
            android:fontFamily="@font/circular_regular"
            android:textAlignment="center"
            android:textColor="?attr/textNormal"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/_8sdp" />

        <!-- Description -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/circular_regular"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:textAlignment="center"
            android:text="Choose your account type to continue"
            android:textColor="?attr/textDark"
            android:textSize="@dimen/_12ssp"
            android:layout_marginBottom="@dimen/_12sdp" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_12sdp">

            <!-- Individual User Option -->
            <LinearLayout
                android:id="@+id/individual_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/_6sdp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:background="@drawable/selector_option_background"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/individual_indicator"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:background="@drawable/circle_selected"
                    android:layout_marginEnd="@dimen/_12sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Individual User"
                    android:fontFamily="@font/circular_regular"
                    android:textColor="?attr/textNormal"
                    android:textSize="@dimen/_14ssp" />

            </LinearLayout>

            <!-- Institution Member Option -->
            <LinearLayout
                android:id="@+id/institution_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/selector_option_background"
                android:layout_marginBottom="@dimen/_6sdp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/institution_indicator"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:background="@drawable/circle_unselected"
                    android:layout_marginEnd="@dimen/_12sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Institution Member"
                    android:fontFamily="@font/circular_regular"
                    android:textColor="?attr/textNormal"
                    android:textSize="@dimen/_14ssp" />

            </LinearLayout>

            <!-- Access Code Input -->
            <EditText
                android:id="@+id/edit_access_code"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:hint="Enter your access code"
                android:fontFamily="@font/circular_regular"
                android:textColor="?attr/textNormal"
                android:textColorHint="?attr/textDark"
                android:textSize="@dimen/_13ssp"
                android:background="@drawable/input_background"
                android:inputType="textCapCharacters"
                android:visibility="gone"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp" />

        </LinearLayout>

        <!-- Dividing Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Button Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:orientation="horizontal">

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/nothing"
                android:elevation="0dp"
                android:fontFamily="@font/circular_regular"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="?attr/textDark"
                android:textSize="@dimen/_14ssp"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?android:attr/listDivider" />

            <!-- Confirm Button -->
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/nothing"
                android:elevation="0dp"
                android:fontFamily="@font/circular_regular"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>