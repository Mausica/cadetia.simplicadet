<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomRedeem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_40sdp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_10sdp"
        android:contentDescription="@string/app_name">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">


            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:id="@+id/redeemClose"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/uni_ic_close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/textNormal" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_230sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/redeemClose">

                <nl.dionsegijn.konfetti.xml.KonfettiView
                    android:id="@+id/konfettiRedeem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/redeemAnimationView"
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_140sdp"
                    android:visibility="visible"
                    android:elevation="6dp"
                    android:layout_centerHorizontal="true"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"/>

                <TextView
                    android:id="@+id/redeemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="center"
                    android:maxLines="3"
                    android:text="Congratulations! You've got X points!"
                    android:layout_below="@+id/redeemAnimationView"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/circular_medium"
                    android:paddingStart="@dimen/_20sdp"
                    android:paddingEnd="@dimen/_20sdp"
                    android:includeFontPadding="false"
                    android:textColor="?attr/textNormal"
                    android:textSize="@dimen/_22ssp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/redeemTitle"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/correct_answers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Correct"
                        android:textColor="?attr/textLight"
                        android:fontFamily="@font/circular_medium"
                        android:textSize="@dimen/_14ssp" />
                    <TextView
                        android:id="@+id/average_response"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 2.5s Average"
                        android:textColor="?attr/textNormal"
                        android:fontFamily="@font/circular_medium"
                        android:textSize="@dimen/_14ssp" />
                </LinearLayout>

            </RelativeLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
