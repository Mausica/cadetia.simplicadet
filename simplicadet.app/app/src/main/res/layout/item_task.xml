<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="@dimen/_8sdp"
    android:layout_marginStart="@dimen/_14sdp"
    android:layout_marginEnd="@dimen/_14sdp"
    android:elevation="@dimen/_5sdp"
    android:backgroundTint="?attr/backgroundLight"
    app:cardElevation="@dimen/_4sdp"
    app:cardCornerRadius="@dimen/_10sdp"
    android:layout_height="wrap_content">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="?attr/backgroundLight">

        <View
            android:id="@+id/view_glowed"
            android:layout_width="@dimen/_6sdp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_5sdp"
            android:elevation="10dp"
            android:outlineSpotShadowColor="@color/red"
            android:background="@drawable/glow_effect_red"
            tools:targetApi="p" />

        <CheckBox
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:button="@drawable/background_checkbox"
            android:id="@+id/checked_task" />

        <!-- New LinearLayout to stack title and date/time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_6sdp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Model task title used as a model in post"
                android:fontFamily="@font/circular_medium"
                android:singleLine="true"
                android:textSize="@dimen/_14ssp"
                android:id="@+id/title"
                android:textColor="?attr/textNormal"/>

            <!-- Date and Time -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_1sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:id="@+id/day"
                    android:fontFamily="@font/circular_medium"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/special_gray"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:id="@+id/date"
                    android:fontFamily="@font/circular_medium"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/special_gray"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nov"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:id="@+id/month"
                    android:fontFamily="@font/circular_medium"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/special_gray"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="16:00"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:id="@+id/time"
                    android:fontFamily="@font/circular_bold"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/special_dark"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
