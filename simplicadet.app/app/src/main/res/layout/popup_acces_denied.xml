<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layoutDeleteNoteContainer"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/nothing">
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_acces_denied"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:orientation="vertical"
            android:paddingTop="@dimen/_12sdp"
            android:elevation="7dp"
            android:layout_marginTop="@dimen/_25sdp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="@dimen/_20sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp"
                android:text="Access denied"
                android:fontFamily="@font/circular_bold"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_16sdp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/circular_medium"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/_6sdp"
                android:text="You do not have sufficient privileges to perform this action. Log in with your organization email to continue."
                android:textColor="@color/white"
                android:alpha="0.8"
                android:textSize="@dimen/_14ssp"
                android:layout_marginLeft="@dimen/_24sdp"
                android:layout_marginRight="@dimen/_24sdp"/>

            <Button
                android:id="@+id/logout_button"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:background="@drawable/button_social"
                app:backgroundTint="@null"
                android:fontFamily="@font/circular_bold"
                android:orientation="vertical"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="?attr/textAppearanceBody1"
                android:textSize="@dimen/_14ssp"
                tools:ignore="VisualLintButtonSize,TextContrastCheck,DuplicateSpeakableTextCheck,VisualLintBounds" />

        </LinearLayout>

        <TextView
            android:id="@+id/dismiss_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/circular_medium"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="DISMISS"
            android:textColor="?attr/textNormal"
            android:alpha="0.8"
            android:textSize="@dimen/_11ssp"
            android:layout_marginLeft="@dimen/_24sdp"
            android:layout_marginRight="@dimen/_24sdp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>