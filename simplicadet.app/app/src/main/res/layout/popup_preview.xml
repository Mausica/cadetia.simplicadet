<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layoutStudentPreviewContainer"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/student_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_delete_note"
        android:layout_marginLeft="@dimen/_40sdp"
        android:layout_marginRight="@dimen/_40sdp"
        android:orientation="vertical"
        android:paddingTop="@dimen/_12sdp"
        android:elevation="7dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Student Image -->
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/studentImage"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="@dimen/_150sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_6sdp"
            android:scaleType="centerCrop"
            android:src="@raw/guest_civil"
            app:riv_corner_radius="@dimen/_15sdp"
            tools:ignore="ContentDescription" />

        <!-- Rank -->
        <TextView
            android:id="@+id/rankText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:text="elev sergent"
            android:fontFamily="@font/circular_regular"
            android:textAlignment="center"
            android:textColor="?attr/textDark"
            android:textSize="@dimen/_12ssp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"/>

        <!-- Name -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:text="Nathan Jones"
            android:fontFamily="@font/circular_regular"
            android:textAlignment="center"
            android:textColor="?attr/textNormal"
            android:textSize="@dimen/_17ssp"
            android:textStyle="bold"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"/>

        <!-- Company • Platoon -->
        <TextView
            android:id="@+id/companyPlatoonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/circular_regular"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:textAlignment="center"
            android:text="Company B • Platoon 2"
            android:textColor="?attr/textDark"
            android:textSize="@dimen/_13ssp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_6sdp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?android:attr/listDivider" />

        <Button
            android:id="@+id/okButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_28sdp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_28sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:background="@color/nothing"
            android:elevation="0dp"
            android:fontFamily="@font/circular_medium"
            android:text="Ok"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="@dimen/_14ssp"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>