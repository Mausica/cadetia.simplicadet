<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/backgroundColor">

    <LinearLayout
        android:id="@+id/drawer_profile"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/img_profile"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_10sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/loading_button"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center"
                android:src="@raw/guest_civil"
                app:shapeAppearanceOverlay="@style/circleImageView"
                />

            <ProgressBar
                android:id="@+id/drawer_progress_bar"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_gravity="center"
                android:indeterminateOnly="false"
                android:progress="58"
                android:progressDrawable="@drawable/home_loading_civil"
                android:rotation="-90" />
        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_12sdp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/drawer_name"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="@dimen/_2sdp"
                android:text=""
                android:textColor="?attr/textAppearanceBody1"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/circular_bold"
                android:gravity="center_vertical"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="@dimen/_2sdp"
                android:textSize="@dimen/_9ssp"
                android:fontFamily="@font/circular_medium"
                android:textColor="@color/light"
                android:text="Radulescu's Family"
                android:gravity="center_vertical"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>