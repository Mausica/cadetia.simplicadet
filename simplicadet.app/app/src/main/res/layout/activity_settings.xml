<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_dark">

    <com.cadetia.simplicadet.entities.LoadingView
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:elevation="12dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar with back button and title -->
        <LinearLayout
            android:id="@+id/settings_top_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back_button"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:src="@drawable/uni_ic_left" />
        </LinearLayout>

        <!-- Content area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/settings_top_bar"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_20sdp">

                <!-- Profile Section -->
                <RelativeLayout
                    android:id="@+id/profile_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp">

                    <!-- Updated Profile Image Container -->
                    <FrameLayout
                        android:id="@+id/profile_image_container"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_80sdp"
                        android:layout_centerHorizontal="true">

                        <FrameLayout
                            android:id="@+id/img_profile"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:layout_gravity="center">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/loading_button"
                                android:layout_width="@dimen/_75sdp"
                                android:layout_height="@dimen/_75sdp"
                                android:layout_gravity="center"
                                android:src="@raw/guest_civil"
                                app:shapeAppearanceOverlay="@style/circleImageView" />

                            <ProgressBar
                                android:id="@+id/drawer_progress_bar"
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_80sdp"
                                android:layout_gravity="center"
                                android:indeterminateOnly="false"
                                android:progress="58"
                                android:progressDrawable="@drawable/home_loading_civil"
                                android:rotation="-90" />
                        </FrameLayout>

                        <ImageButton
                            android:id="@+id/edit_profile_image"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/background_delete_note"
                            android:contentDescription="@string/edit_profile_image"
                            android:src="@drawable/home_ic_picker"
                            tools:ignore="TouchTargetSizeCheck" />
                    </FrameLayout>

                    <!-- Profile Fields -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_below="@id/profile_image_container"
                        android:layout_marginTop="@dimen/_20sdp">

                        <!-- Your name field -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/your_name"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_medium" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settings_name"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingEnd="@dimen/_14sdp"
                            android:background="@drawable/uni_input_search"
                            app:backgroundTint="@null"
                            android:hint="@string/your_name_hint"
                            android:inputType="textPersonName"
                            android:textSize="@dimen/_14ssp"
                            android:textColorHint="?attr/textLight"
                            android:fontFamily="@font/circular_medium" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/30"
                                android:textColor="?attr/textLight"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/circular_bold"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:layout_marginEnd="@dimen/_5sdp"/>
                        </RelativeLayout>

                        <!-- About you field -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_you"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_medium"
                            android:layout_marginTop="@dimen/_15sdp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settings_about"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_70sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingEnd="@dimen/_14sdp"
                            android:paddingTop="@dimen/_10sdp"
                            android:gravity="top|start"
                            android:background="@drawable/uni_input_search"
                            app:backgroundTint="@null"
                            android:hint="@string/about_you_hint"
                            android:inputType="textMultiLine"
                            android:textSize="@dimen/_14ssp"
                            android:textColorHint="?attr/textLight"
                            android:fontFamily="@font/circular_medium" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/90"
                                android:textColor="?attr/textLight"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/circular_bold"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:layout_marginEnd="@dimen/_5sdp"/>
                        </RelativeLayout>

                        <!-- Email field -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/email"
                            android:textColor="?attr/textNormal"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_medium"
                            android:layout_marginTop="@dimen/_5sdp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/login_email"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sdp"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingEnd="@dimen/_14sdp"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:drawablePadding="@dimen/_10sdp"
                            android:ems="10"
                            android:background="@drawable/uni_input_search"
                            app:backgroundTint="@null"
                            android:drawableTint="?attr/textNormal"
                            android:drawableStart="@drawable/auth_ic_email_f"
                            android:hint="@string/login_email"
                            android:inputType="textEmailAddress"
                            android:textSize="@dimen/_14ssp"
                            android:textColorHint="?attr/textLight"
                            android:fontFamily="@font/circular_medium"
                            tools:ignore="VisualLintTextFieldSize" />

                        <!-- App Settings Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_settings"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_bold"
                            android:layout_marginTop="@dimen/_25sdp"
                            android:layout_marginBottom="@dimen/_8sdp" />

                        <!-- Appearance - Single Item Group -->
                        <RelativeLayout
                            android:id="@+id/settings_appearance"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_50sdp"
                            android:background="@drawable/settings_group_background"
                            android:paddingStart="@dimen/_16sdp"
                            android:paddingEnd="@dimen/_16sdp">

                            <ImageView
                                android:id="@+id/appearance_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:contentDescription="@string/appearance"
                                android:src="@drawable/home_ic_theme" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_toEndOf="@id/appearance_icon"
                                android:fontFamily="@font/circular_medium"
                                android:text="@string/appearance"
                                android:textColor="?attr/textAppearanceBody1"
                                android:textSize="@dimen/_14ssp" />

                            <Switch
                                android:id="@+id/theme_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true"
                                android:thumbTint="@color/primary"
                                android:trackTint="@color/primary_transparent"
                                tools:ignore="UseSwitchCompatOrMaterialXml,TouchTargetSizeCheck" />

                        </RelativeLayout>

                        <!-- Contact us Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_us"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_bold"
                            android:layout_marginTop="@dimen/_25sdp"
                            android:layout_marginBottom="@dimen/_8sdp"/>

                        <!-- Contact us group -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Help -->
                            <RelativeLayout
                                android:id="@+id/settings_help"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:background="@drawable/settings_item_top"
                                android:layout_marginBottom="1dp"
                                android:paddingStart="@dimen/_16sdp"
                                android:paddingEnd="@dimen/_16sdp">

                                <ImageView
                                    android:id="@+id/help_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/home_ic_help"
                                    android:layout_centerVertical="true"
                                    android:contentDescription="@string/help" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/help"
                                    android:textColor="?attr/textAppearanceBody1"
                                    android:textSize="@dimen/_14ssp"
                                    android:fontFamily="@font/circular_medium"
                                    android:layout_toEndOf="@id/help_icon"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/_12sdp" />

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/uni_ic_right"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true" />
                            </RelativeLayout>

                            <!-- Terms and Conditions -->
                            <RelativeLayout
                                android:id="@+id/settings_terms"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:layout_marginBottom="1dp"
                                android:background="@drawable/settings_item_middle"
                                android:paddingStart="@dimen/_16sdp"
                                android:paddingEnd="@dimen/_16sdp">

                                <ImageView
                                    android:id="@+id/terms_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/home_ic_upload"
                                    android:layout_centerVertical="true"
                                    android:contentDescription="@string/terms_and_conditions" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/terms_and_conditions"
                                    android:textColor="?attr/textAppearanceBody1"
                                    android:textSize="@dimen/_14ssp"
                                    android:fontFamily="@font/circular_medium"
                                    android:layout_toEndOf="@id/terms_icon"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/_12sdp" />

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/uni_ic_right"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true" />
                            </RelativeLayout>

                            <!-- Privacy Policy -->
                            <RelativeLayout
                                android:id="@+id/settings_privacy"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                android:background="@drawable/settings_item_bottom"
                                android:paddingStart="@dimen/_16sdp"
                                android:paddingEnd="@dimen/_16sdp">

                                <ImageView
                                    android:id="@+id/privacy_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/home_ic_upload"
                                    android:layout_centerVertical="true"
                                    android:contentDescription="@string/privacy_policy" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/privacy_policy"
                                    android:textColor="?attr/textAppearanceBody1"
                                    android:textSize="@dimen/_14ssp"
                                    android:fontFamily="@font/circular_medium"
                                    android:layout_toEndOf="@id/privacy_icon"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/_12sdp" />

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/uni_ic_right"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                        </LinearLayout>

                        <!-- Danger Zone Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/danger_zone"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/circular_bold"
                            android:layout_marginTop="@dimen/_25sdp"
                            android:layout_marginBottom="@dimen/_8sdp" />

                        <!-- Delete Account - Single Item Group -->
                        <RelativeLayout
                            android:id="@+id/settings_delete"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_50sdp"
                            android:background="@drawable/settings_group_background"
                            android:paddingStart="@dimen/_16sdp"
                            android:paddingEnd="@dimen/_16sdp">

                            <ImageView
                                android:id="@+id/delete_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/home_ic_delete"
                                android:layout_centerVertical="true"
                                android:contentDescription="@string/delete_account"
                                app:tint="#FF6B6B"
                                tools:tint="#FF6B6B"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/delete_account"
                                android:textColor="#FF6B6B"
                                android:textSize="@dimen/_14ssp"
                                android:fontFamily="@font/circular_medium"
                                android:layout_toEndOf="@id/delete_icon"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_12sdp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/uni_ic_right"
                                app:tint="#FF6B6B"
                                tools:tint="#FF6B6B"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Log Out Button -->
                        <Button
                            android:id="@+id/logout_button"
                            android:layout_width="@dimen/_150sdp"
                            android:layout_gravity="center"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_25sdp"
                            android:background="@drawable/button_social"
                            app:backgroundTint="@null"
                            android:fontFamily="@font/circular_bold"
                            android:text="@string/log_out"
                            android:textAllCaps="false"
                            android:textColor="?attr/textAppearanceBody1"
                            android:textSize="@dimen/_14ssp" />

                        <!-- Version info - moved inside ScrollView -->
                        <LinearLayout
                            android:id="@+id/version_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="@dimen/_25sdp">

                            <TextView
                                android:id="@+id/app_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/version_info"
                                android:textColor="#8E8E93"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/circular_medium" />

                            <TextView
                                android:id="@+id/copyright_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/copyright_info"
                                android:textColor="#8E8E93"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/circular_medium"
                                android:layout_marginTop="@dimen/_5sdp" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>