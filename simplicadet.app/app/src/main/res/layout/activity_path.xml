<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_dark">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/path_top_bar_container"
            android:elevation="1dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp">

            <FrameLayout
                android:id="@+id/path_blur_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blur_view_path"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>


            <LinearLayout
                android:id="@+id/path_top_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/community_back"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back_button"
                    android:src="@drawable/uni_ic_close"
                    app:tint="?attr/textNormal"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:text="Clasa 11"
                    android:fontFamily="@font/circular_bold"
                    android:textSize="@dimen/_15sdp"
                    android:textColor="?attr/textNormal"
                    android:paddingEnd="@dimen/_45sdp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom|center"
                    android:textAlignment="center"
                    tools:ignore="RtlSymmetry" />

            </LinearLayout>
        </FrameLayout>


        <ScrollView
            android:id="@+id/path_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/_60sdp"
                android:layout_marginTop="@dimen/_5sdp">

                <LinearLayout
                    android:id="@+id/pathView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </LinearLayout>

        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
